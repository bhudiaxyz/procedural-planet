{
  "name": "procedural-planet",
  "version": "1.0.0",
  "title": "Procedural Planet",
  "description": "Procedural Planet",
  "license": "MIT",
  "author": "Bhupendra Bhudia",
  "homepage": "https://github.com/bhudiaxyz/procedural-planet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhudiaxyz/procedural-planet.git"
  },
  "bugs": {
    "url": "https://github.com/bhudiaxyz/procedural-planet/issues"
  },
  "main": "./src/ts/index.ts",
  "scripts": {
    "build": "webpack --progress --mode production --config webpack.config.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "cross-env NODE_ENV=dev webpack serve --progress --open --config webpack.config.js",
    "lint": "eslint src/ts",
    "lint:fix": "npm run lint -- --fix",
    "start": "npm run dev",
    "watch": "npm run dev",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "alea": "^1.0.0",
    "bootstrap": "^5.3.8",
    "lil-gui": "^0.21.0",
    "load-img": "^1.0.0",
    "simplex-noise": "^4.0.3",
    "stats.js": "^0.17.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.13.0",
    "gh-pages": "^6.3.0",
    "glob": "^11.0.1",
    "glsl-noise": "^0.0.0",
    "glslify": "^6.4.1",
    "glslify-hex": "^2.1.1",
    "glslify-loader": "^2.0.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "ify-loader": "^1.0.4",
    "lint-staged": "^17.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "prettier": "^3.5.0",
    "prettier-package-json": "^2.8.0",
    "raw-loader": "^4.0.2",
    "sass": "^1.106.1",
    "sass-loader": "^16.0.5",
    "terser-webpack-plugin": "^5.3.11",
    "typescript": "^7.0.2",
    "webpack": "^5.99.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.1.0"
  },
  "keywords": [
    "babel",
    "computer",
    "es6",
    "generated",
    "graphics",
    "noise",
    "opengl",
    "perlin",
    "procedural",
    "sass",
    "three",
    "threejs",
    "webgl",
    "webpack"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "package.json": [
      "prettier-package-json --write"
    ],
    "*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "semistandard": {
    "globals": [
      "THREE"
    ]
  },
  "allowScripts": {
    "core-js@3.51.0": true,
    "@parcel/watcher@2.6.0": true
  }
}
